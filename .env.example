# Copy to .env and fill in. NEVER commit .env or put these in frontend code.
PORT=3000

# From Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Approved message template that contains "Hi" (see README). "hello_world" works out of the box for testing.
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US

# Only needed if the website is hosted on a different domain than this server (comma-separated)
ALLOWED_ORIGIN=*
